{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenRouter Voice",
  "version": "0.1.0",
  "identifier": "ai.openrouter.voice.example",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "OpenRouter Voice",
        "width": 720,
        "height": 640,
        "minWidth": 550,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 16 }
      },
      {
        "label": "overlay",
        "title": "OpenRouter Voice Overlay",
        "url": "overlay.html",
        "width": 460,
        "height": 130,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visible": false,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.icns", "icons/32x32.png", "icons/128x128.png", "icons/icon.png"],
    "macOS": {
      "hardenedRuntime": false
    }
  }
}
